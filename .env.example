# Copia este fichero a .env (no se sube al repo) y rellénalo.

# Usuario de TikTok que emite (sin @). También se puede pasar al arrancar: npm start -- usuario
TIKTOK_USERNAME=

# Clave de Euler Stream para firmar la conexión (opcional, reduce bloqueos de TikTok)
EULER_API_KEY=

# Carpeta del juego. Por defecto la copia de game/ (se actualiza con "npm run sync:game")
# FLAGMASTER_WWW=C:\Mis documentos\Apks\flagmaster-capacitor\www

# Web de clasificaciones que se anuncia en el directo (vacío = no se anuncia)
# LIVE_SITE_URL=angel-sisamon.github.io/flagmaster-live

# Zona horaria que decide a qué mes pertenece cada directo
# LIVE_TZ=Europe/Madrid

# Grabar el directo (por defecto: sí con usuario de TikTok, no en modo prueba)
# LIVE_RECORD=1

# Subir data/ a GitHub al terminar el directo (por defecto: sí)
# LIVE_AUTOPUBLISH=1

# Bot del chat: propone mensajes en http://localhost:3000/bot (saludos, recordar que se vota con la letra,
# frases sueltas si el chat está parado) para copiarlos y pegarlos en el chat de TikTok.
# CHATBOT=1
# Cuenta con la que pegas los mensajes (por defecto TIKTOK_USERNAME): al volver por el chat se marcan como enviados
# CHATBOT_ACCOUNT=
# Idioma de las frases (server/src/chatbot/phrases/<idioma>.json)
# CHATBOT_LANG=en
# Segundos de silencio antes de proponer una frase suelta (aleatorio entre mínimo y máximo)
# CHATBOT_IDLE_MIN=45
# CHATBOT_IDLE_MAX=90
# Abrir el panel al arrancar (por defecto sí) · CHATBOT_SENDER=console para verlo solo en la consola
# CHATBOT_OPEN_PANEL=1
# Botón "Enviar a Studio" en el panel: pega el mensaje en el chat de TikTok LIVE Studio (clic + Ctrl+V + Enter).
# CHAT_X / CHAT_Y = posición de la caja de chat de Studio en pantalla: sácalas con coordenadas_chat.bat
# CHATBOT_STUDIO=1
# CHAT_X=
# CHAT_Y=
# paste = pega el mensaje de golpe · type = lo teclea letra a letra a ritmo natural (más lento)
# CHAT_INPUT_METHOD=paste

# PORT=3000
