{
  "name": "flagmaster-live",
  "version": "1.0.0",
  "private": true,
  "description": "FlagMaster TikTok LIVE: servidor del directo, estadísticas de cada directo y web de clasificaciones mensuales (GitHub Pages)",
  "license": "UNLICENSED",
  "type": "commonjs",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env server/index.js",
    "sync:game": "node scripts/sync-game.js",
    "studio:coords": "node scripts/studio-coords.js",
    "voices": "node --env-file-if-exists=.env scripts/voices.js",
    "voices:check": "node --env-file-if-exists=.env scripts/voices-check.js",
    "voices:test": "node --env-file-if-exists=.env scripts/voices-test.js",
    "studio:test": "node --env-file-if-exists=.env scripts/studio-test.js",
    "vtuber:test": "node --env-file-if-exists=.env scripts/vtuber-test.js",
    "publish:data": "node scripts/publish.js",
    "build:site": "node scripts/aggregate.js",
    "serve:site": "node scripts/serve-site.js",
    "demo": "node scripts/demo-data.js && node scripts/aggregate.js --sessions .demo/sessions && node scripts/serve-site.js",
    "test": "node --test \"test/*.test.js\""
  },
  "dependencies": {
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "socket.io": "^4.8.4",
    "tiktok-live-connector": "^2.5.0",
    "ws": "^8.22.0"
  },
  "optionalDependencies": {
    "@jitsi/robotjs": "^0.6.24",
    "clipboardy": "^5.3.2",
    "koffi": "^3.3.3"
  },
  "devDependencies": {
    "ffmpeg-static": "^5.3.0"
  }
}
